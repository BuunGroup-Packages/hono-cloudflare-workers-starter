{
  "name": "hono-cloudflare-workers-starter",
  "version": "1.0.0",
  "description": "Production-ready REST API starter with Hono on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create my-database",
    "db:migrate:local": "wrangler d1 execute my-database --local --file=./migrations/0001_create_posts.sql",
    "db:migrate:remote": "wrangler d1 execute my-database --remote --file=./migrations/0001_create_posts.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "logs": "wrangler tail"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "hono": "^4.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2",
    "wrangler": "^4.58.0"
  },
  "keywords": [
    "hono",
    "cloudflare-workers",
    "rest-api",
    "typescript",
    "d1",
    "edge"
  ],
  "author": "Buun Group",
  "license": "MIT"
}
